{
  "name": "ounwan",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:generate:local": "node --env-file=.env.local ./node_modules/drizzle-kit/bin.cjs generate",
    "db:migrate:local": "node --env-file=.env.local ./node_modules/drizzle-kit/bin.cjs migrate",
    "db:studio:local": "node --env-file=.env.local ./node_modules/drizzle-kit/bin.cjs studio",
    "db:up:local": "docker compose --env-file .env.local up -d postgres",
    "db:down": "docker compose down"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "next": "16.3.3",
    "postgres": "^3.4.9",
    "react": "19.2.1",
    "react-dom": "19.2.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.18",
    "@types/node": "24.10.1",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "drizzle-kit": "^0.31.10",
    "tailwindcss": "4.1.18",
    "typescript": "5.9.3"
  }
}
